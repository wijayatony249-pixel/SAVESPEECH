# Environment: development, testing, production
APP_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/savespeech_db

# Security & JWT (Minimal 32 karakter di production)
JWT_SECRET=dev_secret_key_change_in_production_min_32_chars_12345
JWT_EXPIRE_MINUTES=60

# CORS Allowed Origins (pisahkan dengan koma, tanpa wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload & File Limits
MAX_UPLOAD_MB=25
MAX_DURATION_SEC=600
TEMP_DIR=temp_audio
